XferLang 1.0 conformance suite: the JSON to XferLang mapping (spec 8.2).
Each case is <stem>.json and, when a value results, <stem>.xfer (its canonical form); optionally <stem>.diag. See README.md.

-- 820-members-and-nesting.json --
{"a":1,"b":[true,null,"x"],"c":1.50,"d":{},"e":[],"f":{"g":[[],{}]}}
-- 820-members-and-nesting.xfer --
{
    a 1
    b [
        true
        null
        "x"
    ]
    c 1.50
    d {}
    e []
    f {
        g [
            []
            {}
        ]
    }
}
-- 820-root-scalars.json --
42
-- 820-root-scalars.xfer --
42
-- 820-root-string.json --
"text"
-- 820-root-string.xfer --
"text"
-- 820-root-null.json --
null
-- 820-root-null.xfer --
null
-- 820-root-booleans.json --
[true,false]
-- 820-root-booleans.xfer --
[
    true
    false
]
-- 820-whitespace-is-free.json --
 	{ "a" : [ 1 , 2 ] ,
 "b" : { } }
-- 820-whitespace-is-free.xfer --
{
    a [
        1
        2
    ]
    b {}
}
-- 821-numbers-keep-their-spelling.json --
[0,-0,12345678901234567890,1.0,1e5,1E-5,-2.5e+3,0.5,-0.0]
-- 821-numbers-keep-their-spelling.xfer --
[
    0
    -0
    12345678901234567890
    1.0
    1e5
    1E-5
    -2.5e+3
    0.5
    -0.0
]
-- 822-integer-and-fractional-are-different-types.json --
[1,1.0,1e0]
-- 822-integer-and-fractional-are-different-types.xfer --
[
    1
    1.0
    1e0
]
-- 823-escapes-are-decoded.json --
["a\"b","\\","\/","tab\there","nl\nx","\u00e9\u65e5","\ud83d\ude00"]
-- 823-escapes-are-decoded.xfer --
[
    """a"b"""
    "\"
    "/"
    "tab	here"
    "nl
x"
    "é日"
    "😀"
]
-- 823-a-string-is-never-a-symbol.json --
["dark","true","null","1"]
-- 823-a-string-is-never-a-symbol.xfer --
[
    "dark"
    "true"
    "null"
    "1"
]
-- 824-keys-that-need-quoting.json --
{"first name":1,"true":2,"a.b":3,"":4,"日本":5,"inf":6,"9a":7}
-- 824-keys-that-need-quoting.xfer --
{
    "first name" 1
    "true" 2
    a.b 3
    "" 4
    日本 5
    "inf" 6
    "9a" 7
}
-- 825-duplicate-keys-keep-the-last-value.json --
{"a":1,"b":2,"a":3}
-- 825-duplicate-keys-keep-the-last-value.xfer --
{
    a 3
    b 2
}
-- 825-duplicate-keys-keep-the-last-value.diag --
XFER0905 *
